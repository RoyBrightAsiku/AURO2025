// Use this devcontainer.json to develop within a standard Docker environment,
// with VNC providing the GUI support.
// It uses the prebuilt image from the GitHub Container Registry,
// so does not require a Dockerfile.
{
  "name": "auro-vnc",
  "image": "ghcr.io/uoy-robostar/ros2-tb3/auro-dev:latest",
  "privileged": true,
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/${localWorkspaceFolderBasename},type=bind",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "mounts": [
    "source=${localEnv:HOME}${localEnv:USERPROFILE},target=/home/ubuntu/homedir,type=bind"
  ],
  "remoteUser": "ubuntu",
  "portsAttributes": {
      "6080": {
          "label": "Desktop"
      },
      "5000": {
          "label": "GPIG Website"
      },
      "8765": {
          "label": "Foxglove Bridge"
      },
      "27017": {
          "label": "GPIG MongoDB"
      }
  },
  "postCreateCommand": "/workspaces/${localWorkspaceFolderBasename}/.devcontainer/bootstrap-gpig-team-a.sh",
  "postStartCommand": "touch /workspaces/.bash_history && ln -sf /workspaces/.bash_history /home/ubuntu/.bash_history ; /workspaces/${localWorkspaceFolderBasename}/.devcontainer/gitconfig.sh ; /workspaces/${localWorkspaceFolderBasename}/.devcontainer/start-gpig-mongo.sh",
  "remoteEnv": {
    "USERNAME": "${localEnv:USERNAME}",
    "USERDNSDOMAIN": "${localEnv:USERDNSDOMAIN}"
  },
  "containerEnv": {
    "VNC_RESOLUTION": "1280x720x24",
    "GPIG_TEAM_A_REPO": "https://github.com/rs-sandhu/gpig-team-a.git",
    "GPIG_TEAM_A_REF": "main"
  }
}
